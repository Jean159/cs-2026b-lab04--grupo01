@startuml actividades-atencion
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ActivityBackgroundColor #EEF2F8
skinparam ActivityBorderColor #1A3A5C

|Paciente|
start
:Llega a la clínica;

|Admisión|
:Verifica identidad y estado de cita;
if (¿Cita confirmada?) then (sí)
    :Registra llegada del paciente;
    
    fork
        |Admisión|
        :Prepara historia clínica física;
    fork again
        |Paciente|
        :Pasa a sala de espera;
    end fork
    
    |Médico|
    :Llama al paciente desde el consultorio;
    :Realiza consulta médica;
    if (¿Requiere exámenes adicionales?) then (sí)
        :Emite orden de laboratorio;
    else (no)
        :Finaliza consulta directamente;
    endif
    :Registra diagnóstico en el sistema;
    
else (no)
    |Admisión|
    :Informa sobre problema con la cita (no confirmada o inexistente);
    |Paciente|
    :Consulta opciones en recepción;
endif

|Paciente|
:Se retira de la clínica;
stop
@enduml