@startuml paquetes
skinparam shadowing false
skinparam defaultFontName Arial
skinparam packageStyle rectangle

title CitaSalud Arequipa - Paquetes del monolito modular (vista de desarrollo)

package "citasalud" {
    package "auth_usuarios" as AUT
    package "disponibilidad" as DIS
    package "reservas" as RES
    package "cancelaciones" as CAN
    package "notificaciones" as NOT
    package "compartido" as COM
}

RES ..> DIS : usa Horario
CAN ..> DIS : usa (libera cupo)
RES ..> NOT : usa Notificador\n(puerto asíncrono)

AUT ..> COM
DIS ..> COM
RES ..> COM
CAN ..> COM
NOT ..> COM

note bottom of RES
  Regla (ADR-001): sin dependencias cíclicas.
  Notificaciones NO depende de reservas ni viceversa 
  de forma directa (se usa un puerto asíncrono hacia Celery).
end note

@enduml