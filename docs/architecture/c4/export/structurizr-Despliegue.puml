@startuml
skinparam dpi 180
title <size:24>Deployment View: CitaSalud Arequipa - Producción</size>\n<size:24>Nivel Despliegue: Infraestructura del entorno de producción MVP.</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Deployment>

Deployment_Node(user_device, "Dispositivo del Usuario", $type="Hardware de usuario", $descr="Smartphone Android/iOS o PC de escritorio") {
  Container(pwa, "Aplicación Web Progresiva", "React + Vite + Service Worker", "Interfaz web y móvil en navegador")
}

Deployment_Node(vps, "Servidor VPS en la Nube", $type="DigitalOcean / Linode VPS", $descr="Ubuntu 24.04 LTS, 2 vCPU, 4 GB RAM, 80 GB SSD ($24/mes)") {
  Deployment_Node(docker, "Docker Compose", $type="Docker Engine 27 / Compose v2", $descr="Entorno contenedorizado de micro-servicios de monolito") {
    Container(api, "API CitaSalud", "Python 3.12 / Gunicorn / Django", "Backend REST y reglas de negocio")
    Container(worker, "Worker de Tareas Asíncronas", "Celery / Python 3.12", "Procesador de notificaciones y reintentos")
    ContainerDb(db, "Base de Datos", "PostgreSQL 16", "Esquemas por módulo con volumen persistente SSD")
    ContainerQueue(cola, "Cola y Caché", "Redis 7.2 Alpine", "Broker de mensajería y almacenamiento volátil")
  }
}

Rel(pwa, api, "Consume endpoints REST", "HTTPS / TLS 1.3")
Rel(api, db, "Consultas transaccionales", "TCP / Puerto 5432")
Rel(api, cola, "Encolamiento y lectura de turnos", "TCP / Puerto 6379")
Rel(worker, cola, "Consumo continuo de eventos", "TCP / Puerto 6379")

SHOW_LEGEND(true)
@enduml
