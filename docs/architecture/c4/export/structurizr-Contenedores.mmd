      db[("<div style='font-weight: bold'>Base de Datos</div><div style='font-size: 70%'>[Container: PostgreSQL 16]</div><div style='font-size: 80%; margin-top:10px'>Esquemas por módulo de dominio.</div>")]
      style db fill:#438dd5,stroke:#2e6295,color:#ffffff
      cola["<div style='font-weight: bold'>Cola y Caché</div><div style='font-size: 70%'>[Container: Redis 7.2]</div><div style='font-size: 80%; margin-top:10px'>Broker Celery y caché de disponibilidad.</div>"]
      style cola fill:#438dd5,stroke:#2e6295,color:#ffffff
      worker["<div style='font-weight: bold'>Worker de Tareas</div><div style='font-size: 70%'>[Container: Celery]</div><div style='font-size: 80%; margin-top:10px'>Despacho asíncrono de notificaciones.</div>"]
