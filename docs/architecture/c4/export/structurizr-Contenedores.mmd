    1["<div style='font-weight: bold'>Paciente</div><div style='font-size: 70%'>[Person]</div><div style='font-size: 80%; margin-top:10px'>Consulta disponibilidad y reserva.</div>"]
    style 1 fill:#08427b,stroke:#052e56,color:#ffffff
    2["<div style='font-weight: bold'>Personal de Admisión</div><div style='font-size: 70%'>[Person]</div><div style='font-size: 80%; margin-top:10px'>Atención en ventanilla.</div>"]
