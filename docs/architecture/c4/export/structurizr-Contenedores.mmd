    1-. "<div>Accede [HTTPS]</div>" .->pwa
    2-. "<div>Accede [HTTPS]</div>" .->pwa
    3-. "<div>Accede [HTTPS]</div>" .->pwa
    pwa-. "<div>Consume [HTTPS/JSON]</div>" .->api
    api-. "<div>Lee/Escribe [SQL/TCP]</div>" .->db
    api-. "<div>Encola [Redis]</div>" .->cola
    worker-. "<div>Consume [Redis]</div>" .->cola
    worker-. "<div>Despacha [HTTPS/JSON]</div>" .->wa
    api-. "<div>Valida [HTTPS/JSON]</div>" .->reniec
