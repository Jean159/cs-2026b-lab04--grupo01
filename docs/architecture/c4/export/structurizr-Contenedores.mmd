    3["<div style='font-weight: bold'>Médico</div><div style='font-size: 70%'>[Person]</div><div style='font-size: 80%; margin-top:10px'>Agenda de pacientes.</div>"]
    style 3 fill:#08427b,stroke:#052e56,color:#ffffff

    subgraph 4 ["CitaSalud Arequipa"]
      style 4 fill:#ffffff,stroke:#0b4884,color:#0b4884

      pwa["<div style='font-weight: bold'>Aplicación Web Progresiva</div><div style='font-size: 70%'>[Container: React + Vite]</div><div style='font-size: 80%; margin-top:10px'>Interfaz móvil y web para usuarios.</div>"]
