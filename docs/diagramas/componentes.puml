@startuml
skinparam packageStyle rectangle
skinparam defaultTextAlignment center

title CitaSalud Arequipa - Diagrama de Componentes

actor Paciente
actor Medico
actor Admision

package "Monolito Modular (CitaSalud)" {
    [Módulo de Autenticación] as Auth
    [Módulo de Catálogo] as Catalogo
    [Módulo de Reservas] as Reservas
    [Módulo de Notificaciones] as Notificaciones
}

database "Base de Datos Relacional\n(PostgreSQL)" as BD
queue "Cola Asíncrona\n(Redis / Celery)" as Cola
cloud "API de WhatsApp" as WhatsApp

Paciente --> Auth : Login / Registro
Paciente --> Catalogo : Buscar disponibilidad
Paciente --> Reservas : Reservar / Cancelar cita
Medico --> Reservas : Ver lista de pacientes del día

Reservas --> BD : Transacción atómica (Cero duplicados)
Reservas --> Cola : Encolar recordatorio
Cola --> Notificaciones : Procesar envío
Notificaciones --> WhatsApp : Enviar mensaje
@enduml