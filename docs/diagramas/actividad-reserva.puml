@startuml
skinparam defaultTextAlignment center

title CitaSalud Arequipa - Diagrama de Actividad

start
:Paciente ingresa a la plataforma;
:Busca disponibilidad por especialidad;
if (¿Hay horarios libres?) then (Sí)
    :Selecciona horario y presiona "Reservar";
    :Sistema procesa transacción atómica en BD;
    if (¿Se asignó con éxito sin colisión?) then (Sí)
        :Se guarda la cita en el sistema;
        fork
            :Se muestra confirmación al Paciente;
        fork again
            :Se encola tarea asíncrona para WhatsApp;
            :Sistema envía recordatorio vía WhatsApp;
        end fork
        stop
    else (No - Cita ya tomada)
        :Retorna error de conflicto (409);
        :Informa al paciente que el cupo se agotó;
        stop
    endif
else (No)
    :Muestra mensaje de no hay disponibilidad;
    stop
endif

@enduml